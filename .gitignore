node_modules
.nuxt
.output
# Якорь корня обязателен. Без него `dist` накрывал и plugin/dist — тот самый
# устанавливаемый артефакт, который обязан лежать в git (см. ниже). Дефект был
# невидим: игнорируемое не показывается в git status, артефакт лежал на диске,
# все проверки шли по диску — а клон репозитория приезжал без единой строки кода.
/dist
*.log
.DS_Store
.env

# Данные паспортов проектов владельца: журналы фактов, рейтинги, расписания.
# Локальны по замыслу и содержат срезы чужих проектов — в репозиторий не идут.
.data

# Передача сессии между разговорами: рабочий блокнот владельца, не документация.
text.txt
readme-preview.html

# plugin/ НЕ игнорируется намеренно. Это устанавливаемый артефакт, а маркетплейс
# Claude Code умеет только git-источники (github/url/git-subdir/относительный
# путь) — архивов из релизов он не поддерживает. Значит артефакт обязан лежать
# в git, иначе установка из репозитория приедет пустой. Свежесть артефакта
# сторожит scripts/selflint.ts: несобранная или устаревшая сборка падает красным.

# Скриншоты и заметки для переписки — не часть продукта
img.png
*.screenshot.png

# Настройки IDE — не часть продукта
.idea
