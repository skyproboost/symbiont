{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "run",
              "${CLAUDE_PLUGIN_ROOT}/src/hooks/session-start.ts",
              "--data",
              "${CLAUDE_PLUGIN_DATA}"
            ],
            "timeout": 20,
            "statusMessage": "Symbiont: паспорт проекта"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "run",
              "${CLAUDE_PLUGIN_ROOT}/src/hooks/user-prompt.ts",
              "--data",
              "${CLAUDE_PLUGIN_DATA}"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "run",
              "${CLAUDE_PLUGIN_ROOT}/src/hooks/pre-compact.ts",
              "--data",
              "${CLAUDE_PLUGIN_DATA}"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Read",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "run",
              "${CLAUDE_PLUGIN_ROOT}/src/hooks/post-tool.ts",
              "--data",
              "${CLAUDE_PLUGIN_DATA}"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "run",
              "${CLAUDE_PLUGIN_ROOT}/src/hooks/stop.ts",
              "--data",
              "${CLAUDE_PLUGIN_DATA}"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "run",
              "${CLAUDE_PLUGIN_ROOT}/src/hooks/session-end.ts",
              "--data",
              "${CLAUDE_PLUGIN_DATA}"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
