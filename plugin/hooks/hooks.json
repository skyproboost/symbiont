{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/session-start.js",
              "--data",
              "${CLAUDE_PLUGIN_DATA}"
            ],
            "timeout": 20,
            "statusMessage": "Symbiont: паспорт проекта"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/user-prompt.js",
              "--data",
              "${CLAUDE_PLUGIN_DATA}"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/pre-compact.js",
              "--data",
              "${CLAUDE_PLUGIN_DATA}"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Read",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/post-tool.js",
              "--data",
              "${CLAUDE_PLUGIN_DATA}"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/stop.js",
              "--data",
              "${CLAUDE_PLUGIN_DATA}"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/session-end.js",
              "--data",
              "${CLAUDE_PLUGIN_DATA}"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
